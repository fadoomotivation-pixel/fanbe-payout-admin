# ─────────────────────────────────────────────────────────────────────────────
# BrokerPay Pro — Environment variables
#
# Copy this file to `.env` and fill in your own Supabase project values.
# Get them from https://app.supabase.com -> your project -> Project Settings -> API.
#
# Vite only exposes variables prefixed with VITE_ to the browser, so do NOT
# put the service_role key here.  Only the anon public key belongs on the
# frontend; service-role operations run inside the deployed edge functions.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
